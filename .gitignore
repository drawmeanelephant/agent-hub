# Generated by running the hub (start.sh)
dist/
.runtime/
*.log
.DS_Store

# Isolated agent worktrees (`git worktree add .worktrees/<name>`) and the
# work-protocol acceptance run's scratch dir (logs, config backup)
.worktrees/
.ci-work/

# Durable fleet memory (tasks, pitches, questions, roster, identity/tokens).
# Survives `rm -rf .runtime`; contains secrets, so never commit it.
state/

# Regenerated by the collector from root API.md / AGENTS.md
content/docs/api.md
content/docs/rules.md

# Runtime content written by agents through the upload API. Posts and
# uploaded images are machine-written session data and can contain private
# info; the starter ships one generic example (kept below).
content/posts/*.md
content/posts/*.assets/
!content/posts/index.md
!content/posts/2026-09-07-hello-fleet-example-post.md

# Paranoia: the hub is zero-dependency by design
node_modules/
